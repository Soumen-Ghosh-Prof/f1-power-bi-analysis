table _Measures
	lineageTag: 8c67ff10-6542-41f3-9e94-b9e693aba0d6

	measure 'Total Points' = SUM(fact_results[points])
		formatString: 0.0
		lineageTag: c58cc688-9480-4031-ba7e-1e23239c25fd

	measure 'Race Entries' = COUNTROWS(fact_results)
		formatString: #,0
		lineageTag: bde94572-dab1-4426-844d-2f871e2f9133

	measure 'Race Starts' = CALCULATE([Race Entries], fact_results[laps] > 0 || fact_results[starting_position] > 0)
		formatString: #,0
		lineageTag: 396bc376-bc77-42b1-bd88-d155ca40e4d5

	measure 'Seasons Contested' = CALCULATE(DISTINCTCOUNT(dim_races[year]), fact_results[laps] > 0 || fact_results[starting_position] > 0, CROSSFILTER(fact_results[race_id], dim_races[race_id], Both))
		formatString: 0
		lineageTag: 42fbae50-ad1b-4d04-9512-dfd88f996825

	measure 'Circuit Visited' = CALCULATE(DISTINCTCOUNT(dim_races[circuit_id]), fact_results[laps] > 0 || fact_results[starting_position] > 0, CROSSFILTER(fact_results[race_id], dim_races[race_id], Both))
		formatString: 0
		lineageTag: 3b836623-547a-414f-8b7e-98afb50ca391

	measure 'Sprint Points' = SUM(fact_sprint_results[points])
		lineageTag: 41867108-205c-47c0-aaec-897fe40c6b47

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Championship Points' = [Total Points] + COALESCE([Sprint Points], 0)
		lineageTag: 9a320813-f11d-44e3-a954-13e7a99cd197

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Race Wins' = CALCULATE([Race Starts], fact_results[finishing_position] = 1)
		formatString: #,0
		lineageTag: 706f9c31-c7ee-4d3c-b0a5-beb62d86a67d

	measure Podiums = CALCULATE([Race Starts], fact_results[finishing_position] <= 3, NOT(ISBLANK(fact_results[finishing_position])))
		formatString: #,0
		lineageTag: c43a6b8c-7100-4016-8b48-def0ca57b537

	measure 'Points Finishes' = CALCULATE([Race Starts], fact_results[points] > 0)
		formatString: 0
		lineageTag: 31bb9fb5-2538-4dd3-82ec-ca2965acebcc

	measure 'Top 10 Finishes' = CALCULATE([Race Starts], fact_results[finishing_position] <= 10, NOT(ISBLANK(fact_results[finishing_position])))
		formatString: 0
		lineageTag: 13a56fdc-852a-4fc6-917b-169ed4cd571d

	measure 'Pole Positions' = CALCULATE([Race Entries], fact_results[starting_position] = 1)
		formatString: #,0
		lineageTag: d68bc3ec-d679-4a7f-b0f0-621a8d99902e

	measure 'First Row Starts' = CALCULATE([Race Entries], fact_results[starting_position] IN {1,2})
		formatString: 0
		lineageTag: cf8854ad-7788-421c-945a-1ac429be0ce4

	measure 'Avg Starting Position' = CALCULATE(AVERAGE(fact_results[starting_position]), fact_results[starting_position] > 0)
		formatString: 0.0
		lineageTag: 01446da3-1a28-4b8f-8277-c5bd0de2557e

	measure 'Avg Net Positions Gained' = AVERAGEX(FILTER(fact_results, fact_results[starting_position] > 0 && (RELATED(dim_status[status]) = "Finished" || CONTAINSSTRING(RELATED(dim_status[status]), "Lap"))), fact_results[starting_position] - fact_results[finishing_position])
		lineageTag: 5e7fecdc-e531-49a8-8676-a8deb1acac24

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Win %' = DIVIDE([Race Wins], [Race Starts])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: f3d84336-6a33-4c89-89f2-dd850e1ad4d7

	measure 'Podium %' = DIVIDE([Podiums], [Race Starts])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 23e97531-d459-457d-99d9-8f016df5bec2

	measure 'Points Finishes %' = DIVIDE([Points Finishes], [Race Starts])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e463b422-32af-4496-8c6b-42fdd043b2a2

	measure 'Pole-to-Win %' = DIVIDE(CALCULATE([Pole Positions], fact_results[finishing_position] = 1), [Pole Positions])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 49c2eef7-a101-4972-acb5-a15a6b4ae17d

	measure 'First-Row Win %' = DIVIDE(CALCULATE([First Row Starts], fact_results[finishing_position] = 1), [First Row Starts])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d7bb9734-5a98-4d50-b530-6fc30a7b79fa

	measure 'Classified Finishes' = CALCULATE([Race Starts], NOT(ISBLANK(fact_results[finishing_position])))
		formatString: #,0
		lineageTag: e364610e-b6c5-4574-a858-6fd1cbcf2f8f

	measure DNFs = CALCULATE([Race Starts], ISBLANK(fact_results[finishing_position]))
		formatString: #,0
		lineageTag: 47c9e93a-e57a-4b28-bfb6-28d5adbf67da

	measure 'DNF %' = DIVIDE([DNFs], [Race Starts])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 19738a40-10d6-4b7e-b5ef-e76aa7e4cd6d

	measure 'Mechanical DNFs' = CALCULATE([DNFs], dim_status[status_category] = "Mechanical")
		formatString: 0
		lineageTag: 30a0e7db-10bc-418d-bd29-ab24840515f1

	measure 'Incident DNFs' = CALCULATE([DNFs], dim_status[status_category] = "Incident")
		formatString: 0
		lineageTag: bca60066-ae65-4d3f-8943-1f25033cb4a1

	measure 'Mechanical DNF %' = DIVIDE([Mechanical DNFs], [DNFs])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 2403c2ff-6db4-404f-b5fc-362ba1087455

	measure 'Other DNFs' = CALCULATE([DNFs], NOT(dim_status[status_category] IN {"Mechanical", "Incident"}))
		formatString: 0
		lineageTag: fd10b258-18be-4ee5-8031-70c206638f82

	measure 'Incident DNF %' = DIVIDE([Incident DNFs], [DNFs])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 4025b2db-4b77-4397-a645-1fe4766faeae

	measure 'Other DNF %' = DIVIDE([Other DNFs], [DNFs])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 0fb75965-7d92-4b67-8a50-6af6956782bc

	measure 'Total Pit Stops' = COUNTROWS(fact_pit_stops)
		formatString: 0
		lineageTag: 709e8a4d-2537-43bd-98d5-b0ec60ce7f42

	measure 'Avg Pit Stop Time' = DIVIDE(CALCULATE(AVERAGE(fact_pit_stops[milliseconds]), fact_pit_stops[milliseconds] <= 45000), 1000)
		formatString: 0.000
		lineageTag: 778d4ec4-6b25-4f5e-ab02-d57b780f4a23

	measure 'Fastest Pit Stop' = DIVIDE(MIN(fact_pit_stops[milliseconds]), 1000)
		formatString: 0.000
		lineageTag: 9f830dae-f5db-498f-8012-557d9da89ca0

	measure 'Fastest Laps' = CALCULATE(COUNTROWS(fact_results), fact_results[fastest_lap_rank] = 1)
		formatString: 0
		lineageTag: e6ef8181-287f-4de7-a9be-5558abf9467a

	measure 'Fastest Lap %' = DIVIDE([Fastest Laps], [Race Starts])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: c0135e1c-6723-4eae-8c6f-7367c3033374

	measure 'Avg Lap Time (s)' = DIVIDE(AVERAGE(fact_lap_times[milliseconds]), 1000)
		formatString: 0.000
		lineageTag: da5f2dc9-4bea-4bfb-9a93-6c04dc74b4ef

	measure 'Fastest Personal Lap (s)' = DIVIDE(MIN(fact_lap_times[milliseconds]), 1000)
		formatString: 0.000
		lineageTag: ab5edf50-edf7-4d29-ae93-eb5899055e95

	measure 'Max Avg Lap Speed (km/h)' = MAX(fact_results[fastest_lap_avg_speed])
		formatString: 0.0
		lineageTag: 33634b4d-e5ae-4f0f-b74f-cc009e40b82b

	measure 'Avg Lap Speed (km/h)' = AVERAGE(fact_results[fastest_lap_avg_speed])
		formatString: 0.0
		lineageTag: 64a8702e-52bc-407c-b1d9-dcfc2666c08f

	measure 'Points per Start' = DIVIDE([Total Points], [Race Starts])
		formatString: 0.00
		lineageTag: 08462c08-7890-472f-9137-42195a57ae2d

	measure 'Win-to-Podium %' = DIVIDE([Race Wins], [Podiums])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 4233554e-6508-4b0c-b877-e5c59894d130

	measure '1-2 Finishes' = COUNTROWS(FILTER(SUMMARIZE(fact_results, fact_results[race_id], fact_results[consturctor_id], "P1-Count", CALCULATE(COUNTROWS(fact_results), fact_results[finishing_position] = 1), "P2-Count", CALCULATE(COUNTROWS(fact_results), fact_results[finishing_position] = 2)), [P1-Count] = 1 && [P2-Count] = 1))
		formatString: 0
		lineageTag: 1ce4a106-02ba-4f22-b319-b4ed3823c23f

	measure 'Double Points Finishes' = COUNTROWS(FILTER(SUMMARIZE(fact_results, fact_results[race_id], fact_results[consturctor_id], "Scoring-Drivers", CALCULATE(COUNTROWS(fact_results), fact_results[points] > 0)), [Scoring-Drivers] >= 2))
		formatString: #,0
		lineageTag: b98e0e60-d388-4b8c-9fb6-594053a0a11c

	measure Hat-Tricks = CALCULATE(COUNTROWS(fact_results), fact_results[starting_position] = 1, fact_results[finishing_position] = 1, fact_results[fastest_lap_rank] = 1)
		formatString: 0
		lineageTag: ac5e032a-fbfb-4b55-9bde-4635826f62d9

	measure 'Normalized Points' = SUMX(fact_results, SWITCH(fact_results[finishing_position], 1, 25, 2, 18, 3, 15, 4, 12, 5, 10, 6, 8, 7, 6, 8, 4, 9, 2, 10, 1, 0))
		formatString: #,0.0
		lineageTag: 93a36122-cb8b-4ec0-8efb-37730177b059

	measure 'Normalized Points per Start' = DIVIDE([Normalized Points], [Race Starts])
		lineageTag: 59f9289a-f801-4c9b-8c4d-2fffac17ad04

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Constructor Color' =
			VAR Constructor = SELECTEDVALUE(dim_constructors[constructor_ref])
			RETURN
			SWITCH(
			    TRUE(),
			
			    -- Ferrari
			    Constructor IN {
			        "ferrari",
			        "de_tomaso-ferrari"
			    }, "#E8002D",
			
			    -- McLaren
			    Constructor IN {
			        "mclaren",
			        "mclaren-ford",
			        "mclaren-seren",
			        "mclaren-brm",
			        "mclaren-alfa_romeo"
			    }, "#FF8000",
			
			    -- Williams
			    Constructor = "williams", "#00A3E0",
			
			    -- Red Bull
			    Constructor = "red_bull", "#3671C6",
			
			    -- Mercedes
			    Constructor = "mercedes", "#00D2BE",
			
			    -- Renault
			    Constructor = "renault", "#FFF500",
			
			    -- Benetton
			    Constructor = "benetton", "#008C95",
			
			    -- Brawn
			    Constructor = "brawn", "#B6E300",
			
			    -- Aston Martin
			    Constructor = "aston_martin", "#00665E",
			
			    -- Alpine
			    Constructor = "alpine", "#0090FF",
			
			    -- Lotus family
			    Constructor IN {
			        "team_lotus",
			        "lotus-climax",
			        "lotus-ford",
			        "lotus-brm",
			        "lotus-maserati",
			        "lotus-borgward",
			        "lotus-pw"
			    }, "#008C45",
			
			    -- Brabham family
			    Constructor IN {
			        "brabham",
			        "brabham-ford",
			        "brabham-climax",
			        "brabham-brm",
			        "brabham-repco",
			        "brabham-alfa_romeo"
			    }, "#00529B",
			
			    -- BRM family
			    Constructor IN {
			        "brm",
			        "brm-ford"
			    }, "#006B3F",
			
			    -- Tyrrell
			    Constructor = "tyrrell", "#0055A5",
			
			    -- Matra
			    Constructor IN {
			        "matra",
			        "matra-ford"
			    }, "#0080C8",
			
			    -- Cooper family
			    Constructor IN {
			        "cooper",
			        "cooper-climax",
			        "cooper-ford",
			        "cooper-brm",
			        "cooper-ferrari",
			        "cooper-ats",
			        "cooper-alfa_romeo",
			        "cooper-maserati",
			        "cooper-osca",
			        "cooper-borgward"
			    }, "#0047AB",
			
			    -- Vanwall
			    Constructor = "vanwall", "#006B3F",
			
			    -- Honda
			    Constructor = "honda", "#FFFFFF",
			
			    -- Sauber
			    Constructor = "sauber", "#00A550",
			
			    -- Force India
			    Constructor = "force_india", "#F596C8",
			
			    -- Everything else
			    "#808080"
			)
		lineageTag: 636bbcd1-b74a-4860-9e3b-8574edad8bc3

	measure 'Total Races' = DISTINCTCOUNT(dim_races[race_id])
		formatString: #,0
		lineageTag: f5219f81-1ebf-4da9-bfa0-35caa8f07e33

	measure 'Driver Bar Colour' = VAR CurrentDriverWins = [Race Wins] VAR MaxWinsInContext = MAXX(ALLSELECTED(dim_drivers[driver_name]), [Race Wins]) RETURN IF(CurrentDriverWins = MaxWinsInContext && CurrentDriverWins > 0, "#64748B", "#94A3B8")
		lineageTag: 3287ae93-eaf1-427c-9e1c-f809addd84ad

	measure 'Min Avg Lap Speed (km/h)' = MIN(fact_results[fastest_lap_avg_speed])
		formatString: 0.0
		lineageTag: 4c5087b8-9e67-4a40-824b-032a9fd20545

	measure 'Avg Finishing Position' = AVERAGEX(FILTER(fact_results, NOT(ISBLANK(fact_results[finishing_position])) && fact_results[finishing_position] > 0), fact_results[finishing_position])
		formatString: 0.0
		lineageTag: da072520-0a75-40c6-a65b-cae1370486f6

	measure 'Top Driver With Wins' =
			
			VAR DriverSummary = ADDCOLUMNS(VALUES(dim_drivers[driver_name]), "@Wins", [Race Wins])
			VAR TopRow = TOPN(1, DriverSummary, [@Wins], DESC)
			VAR BestDriverName = MAXX(TopRow, dim_drivers[driver_name])
			VAR BestDriverWins = MAXX(TopRow, [@Wins])
			RETURN IF(BestDriverWins > 0, BestDriverName & " (" & FORMAT(BestDriverWins, "#,##0") & ")", "N/A")
		lineageTag: 34ca38e9-5ee4-435f-97ba-27f5bc3535f2

	measure 'Top Team With Wins' =
			
			VAR TeamSummary = ADDCOLUMNS(VALUES(dim_constructors[constructor_name]), "@Wins", [Race Wins])
			VAR TopRow = TOPN(1, TeamSummary, [@Wins], DESC)
			VAR BestTeamName = MAXX(TopRow, dim_constructors[constructor_name])
			VAR BestTeamWins = MAXX(TopRow, [@Wins])
			RETURN IF(BestTeamWins > 0, BestTeamName & " (" & FORMAT(BestTeamWins, "#,##0") & ")", "N/A")
		lineageTag: bd3d1d9e-a826-4607-b013-6a165d4ef767

	measure 'Selected Driver Header' = SELECTEDVALUE(dim_drivers[driver_name], "SELECT A DRIVER")
		lineageTag: 91ce6c49-c50a-4216-bd4b-dc03a1c7e8a1

	measure 'Selected Team Header' = SELECTEDVALUE(dim_constructors[constructor_name], "SELECT A TEAM")
		lineageTag: e954cc34-c715-4cca-a444-4189f90021ec

	measure 'Sprint Starts' = CALCULATE(COUNTROWS(fact_sprint_results), fact_sprint_results[laps] > 0 || fact_sprint_results[starting_position] > 0)
		formatString: #,0
		lineageTag: aaf54875-de3f-4f59-bca3-ceacf1d99121

	measure 'Sprint Wins' = CALCULATE([Sprint Starts], fact_sprint_results[finishing_position] = 1)
		formatString: #,0
		lineageTag: 783a0a33-4ad2-4b59-b73e-a69f0f42b850

	measure 'Sprint Win %' = DIVIDE([Sprint Wins], [Sprint Starts])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: fb175326-6bfb-4198-bc49-7530ad838bcb

	measure Grid-Wins = CALCULATE(COUNTROWS(fact_results), fact_results[finishing_position] = 1)
		formatString: #,0
		lineageTag: d3cdb87d-5a36-4721-9340-322de71a4567

	partition _Measures = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

