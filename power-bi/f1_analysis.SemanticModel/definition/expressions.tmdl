expression status =
		let
		    Source = Csv.Document(File.Contents("C:\data-analytics-projects\power-bi-portfolio-project\data\F1-Race\status.csv"),[Delimiter=",", Columns=2, Encoding=1252, QuoteStyle=QuoteStyle.None]),
		    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
		    #"Renamed Columns" = Table.RenameColumns(#"Promoted Headers",{{"statusId", "status_id"}}),
		    #"Changed Type" = Table.TransformColumnTypes(#"Renamed Columns",{{"status_id", Int64.Type}}),
		    #"Added Custom" = Table.AddColumn(#"Changed Type", "status_category", each if [status] = "Finished" then
		    "Finished"
		
		else if Text.StartsWith([status], "+") then
		    "Lapped"
		
		else if List.Contains(
		    {
		        "Accident",
		        "Collision",
		        "Spun off",
		        "Fatal accident",
		        "Collision damage",
		        "Damage",
		        "Debris",
		        "Front wing",
		        "Broken wing"
		    },
		    [status]
		) then
		    "Incident"
		
		else if List.Contains(
		    {
		        "Physical",
		        "Injured",
		        "Injury",
		        "Driver unwell",
		        "Eye injury",
		        "Illness"
		    },
		    [status]
		) then
		    "Driver"
		
		else if List.Contains(
		    {
		        "Disqualified",
		        "107% Rule",
		        "Underweight",
		        "Safety belt",
		        "Excluded"
		    },
		    [status]
		) then
		    "Penalty"
		
		else if List.Contains(
		    {
		        "Did not qualify",
		        "Did not prequalify"
		    },
		    [status]
		) then
		    "DNQ"
		
		else if List.Contains(
		    {
		        "Withdrew",
		        "Not classified",
		        "Not restarted",
		        "Retired"
		    },
		    [status]
		) then
		    "Race Status"
		
		else if List.Contains(
		    {
		        "Safety",
		        "Safety concerns"
		    },
		    [status]
		) then
		    "Safety"
		
		else
		    "Mechanical")
		in
		    #"Added Custom"
	lineageTag: ea38c056-12b7-4a52-8689-8e4d7718d11c
	queryGroup: staging

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

